#!/usr/bin/env bash

set -e # Exit immediately if a command exits with a non-zero status

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$DOTFILES_DIR"

echo "======================================="
echo " Setting up your development environment"
echo "======================================="

# 1. Ensure GNU Stow is installed
if ! command -v stow &> /dev/null; then
    echo "📦 GNU Stow not found. Attempting to install..."
    
    if command -v apt-get &> /dev/null; then
        sudo apt-get update && sudo apt-get install -y stow
    elif command -v dnf &> /dev/null; then
        sudo dnf install -y stow
    elif command -v pacman &> /dev/null; then
        sudo pacman -S --noconfirm stow
    else
        echo "❌ Could not find a supported package manager (apt, dnf, pacman)."
        echo "Please install GNU Stow manually and re-run this script."
        exit 1
    fi
fi

# 2. Define the packages you want to stow
# Add or remove folder names here as your repository grows
PACKAGES=(
    "shell"
    "agents"
    "git"
)

# 3. Stow the packages
echo "🔗 Creating symlinks with GNU Stow..."
for package in "${PACKAGES[@]}"; do
    if [ -d "$package" ]; then
        echo " -> Stowing $package..."
        # The -R option rests any broken links or updates changed structures
        stow -Rv "$package" -t ~
    else
        echo "⚠️  Warning: Folder '$package' not found in dotfiles directory. Skipping."
    fi
done

# 4. Link agent skills and MCP config to Antigravity global configuration
# Both are aliases of the stowed copies in ~/.agents, so the global config
# directory follows this repository without a second place to edit.
if [ -d "$HOME/.agents/skills" ] || [ -f "$HOME/.agents/mcp.json" ]; then
    echo "🤖 Linking agent configuration to Antigravity global configuration..."
    mkdir -p "$HOME/.gemini/config"
fi
if [ -d "$HOME/.agents/skills" ]; then
    ln -sfn "$HOME/.agents/skills" "$HOME/.gemini/config/skills"
fi
if [ -f "$HOME/.agents/mcp.json" ]; then
    ln -sfn "$HOME/.agents/mcp.json" "$HOME/.gemini/config/mcp_config.json"
fi

# 5. Point this repository at the hooks it ships
# core.hooksPath is repository-local, so the secrets guard applies to commits
# made here and nowhere else.
echo "🪝 Enabling the secrets pre-commit hook..."
git -C "$DOTFILES_DIR" config core.hooksPath .githooks

# 6. Remind the user about their machine-local secrets
# Optional by design: ~/.bashrc sources it only when it exists.
if [ ! -f "$HOME/.secrets" ]; then
    echo "🔑 No ~/.secrets yet. Copy ~/.secrets.example to ~/.secrets to set credentials."
fi

# 7. Check the skill inventory
# Best-effort: reports drift but never blocks setup.
echo "🔎 Checking the skill inventory..."
if [ -x "$DOTFILES_DIR/check-skills" ]; then
    if ! "$DOTFILES_DIR/check-skills"; then
        echo "⚠️  Skill inventory drift detected above. Setup continues."
    fi
else
    echo "⚠️  check-skills not found or not executable. Skipping."
fi

echo "🎉 Setup complete! Your configurations are linked."
