# ~/.secrets.example - template for the untracked secrets script.
#
# ~/.secrets is sourced by ~/.bashrc. It is deliberately NOT tracked by this
# repository, so machine-local credentials never reach git. Set it up with:
#
#     cp ~/.secrets.example ~/.secrets
#     chmod 600 ~/.secrets
#     $EDITOR ~/.secrets
#
# The file is an ordinary shell script: one export per line, exactly as it
# would appear in ~/.bashrc. Keep real values out of this template.

export RENDER_API_KEY=""
# export GITHUB_TOKEN=""
# export SOME_OTHER_API_KEY=""
